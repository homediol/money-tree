# PostgreSQL round history storage
# PostgreSQL is required; the collector exits on database failure rather than
# splitting new history into a local JSON fallback. Existing JSON is imported
# once on startup when it contains rounds missing from the database.
DATABASE_URL=postgresql://postgres:123456@localhost:5432/postgres
REQUIRE_POSTGRES=true
ROUND_HISTORY_TABLE=aviator_rounds
# Background backend-staging timeout; queued round events retry without stopping capture.
COLLECTOR_BACKEND_EVENT_TIMEOUT_MS=3000

# Browser recovery. If the dedicated bot profile cannot open Aviator, the
# collector can use the last-used Google Chrome profile. Override its name
# (for example "Default" or "Profile 5") when needed.
BOT_GOOGLE_USER_DATA_DIR=/home/diolo/.config/google-chrome
# Existing Winner virtual Aviator route and its observed Spribe provider host.
WINNER_AVIATOR_URL=https://winner.rw/en/virtual/crash-games/aviator
BOT_GAME_PROVIDER_HOSTS=spribegaming.com
BOT_NETWORK_POLL_MS=15000
# Betting controls are coordinated on the collector's single Aviator tab.
# No separate betting page or Aviator game session is supported.
# BOT_GOOGLE_PROFILE=Profile 5
# BOT_CDP_PORT=9222
# BOT_INITIAL_FRAME_TIMEOUT=30000
# BOT_FRAME_TIMEOUT=120000
