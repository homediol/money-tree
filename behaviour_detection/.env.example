# Behaviour Detection owns these credentials. Do not copy Winner Predict values.
# These are independent of Winner Predict. Point them at a local PostgreSQL
# server (default port 5432), or set BEHAVIOUR_DATABASE_URL to a local SQLite
# development URL and clear the PostgreSQL component fields. Password
# characters are URL-escaped by SQLAlchemy; do not hand-build a connection URL.
BEHAVIOUR_DB_NAME=behaviour_detection
BEHAVIOUR_DB_USER=behaviour_user
BEHAVIOUR_DB_PASSWORD=REPLACE_WITH_PRIVATE_PASSWORD
BEHAVIOUR_DB_HOST=127.0.0.1
BEHAVIOUR_DB_PORT=5432
# Optional local SQLite development database (takes precedence over PostgreSQL):
# BEHAVIOUR_DATABASE_URL=sqlite:///./data/behaviour_detection.sqlite3

# Live rounds are read-only from backend/.env DATABASE_URL by default.
# Set this only to use a different Winner Predict PostgreSQL connection.
# BEHAVIOUR_SOURCE_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/winner_predict
BEHAVIOUR_WINNER_SYNC_SECONDS=1

# Independent Orbit Data Watch connection. These are intentionally blank until
# a separate Behaviour API key is issued and configured securely.
# ORBIT_API_BASE_URL=http://localhost:4000 is also accepted; the
# BEHAVIOUR_ORBIT_API_BASE_URL name remains supported for existing installs.
BEHAVIOUR_ORBIT_API_BASE_URL=
BEHAVIOUR_ORBIT_API_KEY=
# ORBIT_API_KEY is accepted and takes precedence when both key names are set.
BEHAVIOUR_ORBIT_WATCH_ID=
# Optional container-only URL. It is not used by the npm startup path.
BEHAVIOUR_ORBIT_CONTAINER_API_BASE_URL=
BEHAVIOUR_ORBIT_POLL_SECONDS=2
BEHAVIOUR_ORBIT_PAGE_SIZE=100
BEHAVIOUR_ORBIT_CONNECT_TIMEOUT_SECONDS=5
BEHAVIOUR_ORBIT_REQUEST_TIMEOUT_SECONDS=15

BEHAVIOUR_API_HOST=127.0.0.1
BEHAVIOUR_API_PORT=8100
# Existing Winner Predict backend endpoint used only for durable Rolling HIGH SHADOW intents.
BEHAVIOUR_SHADOW_BACKEND_URL=http://127.0.0.1:8000
# Defaults to API_KEY read server-side from backend/.env; never sent to the browser.
# Set this only when Behavior and Winner Predict use separate env files.
BEHAVIOUR_SHADOW_BACKEND_API_KEY=
# Optional shared secret; if set, configure the same value in backend/.env.
BEHAVIOUR_SHADOW_SHARED_SECRET=
BEHAVIOUR_CORS_ORIGINS=["http://localhost:5173","http://localhost:5174","http://127.0.0.1:5173","http://127.0.0.1:5174"]
BEHAVIOUR_TIME_GROUP_GAP_SECONDS=180.0452
BEHAVIOUR_STATE_CONFIRM_ROUNDS=3
BEHAVIOUR_MIN_STATE_ROUNDS=20
BEHAVIOUR_IMPORT_BATCH_SIZE=1000
BEHAVIOUR_LOG_LEVEL=INFO
