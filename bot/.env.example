# PostgreSQL round history storage
# The collector imports data/roundhistory.json once on startup, then saves new rounds here.
DATABASE_URL=postgresql://postgres:123456@localhost:5432/postgres
ROUND_HISTORY_TABLE=aviator_rounds

# Browser recovery. If the dedicated bot profile cannot open Aviator, the
# collector can use the last-used Google Chrome profile. Override its name
# (for example "Default" or "Profile 5") when needed.
BOT_GOOGLE_USER_DATA_DIR=/home/diolo/.config/google-chrome
# BOT_GOOGLE_PROFILE=Profile 5
# BOT_CDP_PORT=9222
# BOT_INITIAL_FRAME_TIMEOUT=30000
# BOT_FRAME_TIMEOUT=120000
