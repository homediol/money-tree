# Winner Predict backend configuration
#
# Copy to backend/.env and adjust as needed. Settings are read from the
# environment and from backend/.env while uvicorn runs from the backend/
# directory. Field names map to the Settings model in app/core/config.py
# (case-insensitive: DATA_PATH -> data_path).
#
# Every variable below is optional. PostgreSQL is the production history source.

# APP_NAME=Winner Predict
# Number of recent rounds used for collector continuity status.
# HISTORY_STATUS_WINDOW_ROUNDS=100

# Paths set here are resolved relative to the backend/ working directory.
# Aviator history, sessions, decisions, executions, and settings
# use PostgreSQL as the durable source of truth. The legacy JSON history is
# read only for a one-time import when no import marker exists.
DATABASE_URL=postgresql://winner:password@127.0.0.1:5432/winner_predict
REQUIRE_POSTGRES=true
# DATA_PATH=../data/roundhistory.json  # legacy one-time import only
# DATABASE_PATH=winner_predict.sqlite3 # isolated tests only; not production

# List values must be JSON-encoded in the environment.
# CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]
# Origins allowed to call the external round API from browser projects.
# This is an origin allowlist only; every request still needs its own project token.
# ROUND_STREAM_ALLOWED_ORIGINS=["https://consumer.example"]
# Retained committed round events for API replay (minimum 1,000; maximum 1,000,000).
# ROUND_STREAM_RETENTION=100000

# Set a long random value in production. When configured, this bearer token
# protects /api/* requests unless PUBLIC_ACCESS=true.
# API_KEY=replace-with-at-least-16-random-characters
# Optional collector event URL when the API is not reachable at localhost:8000.
# The collector reads this setting from backend/.env and never logs the token.
# COLLECTOR_BACKEND_ROUND_OBSERVED_URL=http://127.0.0.1:8000/api/collector/round-observed
# Optional committed-event endpoint override (normally same API origin).
# COLLECTOR_BACKEND_ROUND_PERSISTED_URL=http://127.0.0.1:8000/api/collector/round-persisted
# Bound collector HTTP retries, event outbox, and API-side durable pending spool.
# COLLECTOR_BACKEND_EVENT_TIMEOUT_MS=3000
# COLLECTOR_OUTBOX_MAX_RECORDS=50000
# COLLECTOR_OUTBOX_MAX_BYTES=67108864
# COLLECTOR_OBSERVATION_SPOOL_PATH=../data/backend/round-observation-inbox.sqlite3
# COLLECTOR_OBSERVATION_SPOOL_MAX_RECORDS=50000
# COLLECTOR_OBSERVATION_SPOOL_MAX_BYTES=67108864
# Let visitors use dashboard reads and actions without a token.
# PUBLIC_ACCESS=true

# Backend process ownership. Keep one instance on port 8000; the supervisor
# validates /health before reusing an existing listener.
# BACKEND_HOST=0.0.0.0
# BACKEND_PORT=8000
# ENFORCE_SINGLE_INSTANCE=true
# INSTANCE_LOCK_PATH=/tmp/winner-predict-backend-8000.lock
