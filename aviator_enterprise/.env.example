# ============================================================================
# Aviator ML Enterprise - Environment Configuration
# ============================================================================

# --- Application ---
APP_NAME=aviator-ml-enterprise
APP_VERSION=2.0.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
SECRET_KEY=change-me-in-production-use-a-strong-random-key

# --- Server ---
HOST=0.0.0.0
PORT=8000
WORKERS=4
CORS_ORIGINS=*

# --- Paths ---
ARTIFACTS_DIR=./artifacts
DATA_DIR=./data
MODELS_DIR=./artifacts/models
DATASETS_DIR=./artifacts/datasets
LOGS_DIR=./artifacts/logs
REPORTS_DIR=./artifacts/reports

# --- Data Source ---
DATA_SOURCE=local
ROUND_HISTORY_PATH=./data/example.roundhistory.json

# --- Model Configuration ---
SEQUENCE_LENGTH=24
FORECAST_HORIZON=1
N_CLASSES=5
CLASSIFICATION_MODE=multi_class

# --- Feature Engineering ---
ROLLING_WINDOWS=5,10,20,50,100
EMA_SPANS=5,10,20,50
LAG_PERIODS=1,2,3,5,10
VOLATILITY_WINDOWS=10,20,50

# --- Training ---
TEST_SIZE=0.2
VALIDATION_SIZE=0.15
CV_FOLDS=5
N_BOOTSTRAP=200
OPTUNA_TRIALS=50
OPTUNA_TIMEOUT=1800
EARLY_STOPPING_PATIENCE=10
BATCH_SIZE=64
MAX_EPOCHS=100

# --- Class Imbalance ---
IMBALANCE_STRATEGY=class_weight
SMOTE_RATIO=auto

# --- Calibration ---
CALIBRATION_METHOD=temperature
CALIBRATION_SPLIT=0.2

# --- Drift Detection ---
DRIFT_WINDOW=200
DRIFT_THRESHOLD=0.05
DRIFT_CHECK_INTERVAL=300
RETRAIN_MIN_NEW_ROUNDS=50
RETRAIN_MIN_IMPROVEMENT=0.01

# --- Uncertainty ---
UNCERTAINTY_THRESHOLD=0.55
MIN_CONFIDENCE=0.35
MAX_UNCERTAINTY=0.25

# --- Ensemble ---
ENSEMBLE_METHOD=stacking
ENSEMBLE_WEIGHTS=auto

# --- Dashboard ---
DASHBOARD_REFRESH_MS=3000
PREDICTION_LOG_SIZE=500
DASHBOARD_HISTORY_DAYS=30

