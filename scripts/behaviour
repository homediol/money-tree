#!/bin/sh
set -eu
ROOT_DIR=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
ENV_DIR="$ROOT_DIR/behaviour_detection"
VENV_DIR="$ENV_DIR/.venv"

if [ ! -x "$VENV_DIR/bin/python" ]; then
  python3 -m venv "$VENV_DIR"
fi
if [ ! -f "$VENV_DIR/.requirements-installed" ] || \
   [ "$ENV_DIR/requirements.txt" -nt "$VENV_DIR/.requirements-installed" ] || \
   [ "$ENV_DIR/requirements.lock" -nt "$VENV_DIR/.requirements-installed" ] || \
   [ "$ENV_DIR/requirements-test.txt" -nt "$VENV_DIR/.requirements-installed" ]; then
  "$VENV_DIR/bin/python" -m pip install --disable-pip-version-check -r "$ENV_DIR/requirements-test.txt"
  touch "$VENV_DIR/.requirements-installed"
fi
cd "$ROOT_DIR"
exec "$VENV_DIR/bin/python" -m behaviour_detection.cli "$@"
